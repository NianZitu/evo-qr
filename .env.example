# Conexão com o Postgres (no Easypanel, copie a "Internal Connection URL" do serviço)
DATABASE_URL=postgres://postgres:SENHA@projeto_postgres:5432/evolutionqr

# Endereço da sua Evolution API e a chave global (AUTHENTICATION_API_KEY)
EVOLUTION_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=sua-chave-global

# Senha para entrar no painel. Use uma senha longa.
ADMIN_PASSWORD=troque-esta-senha

PORT=3000
